  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates NCCL bandwidth and latency. On one GPU the three metrics are na (needs two GPUs)"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/nccl_bw.cu with nvcc/NCCL and run bin/nccl_bw for each collective and message size, parse busbw_gb_s, algbw_gb_s, and latency_us, to measure NCCL collective bandwidth. This is not upstream nccl-tests or MPI"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Sweep message sizes per collective with the local bin/nccl_bw (single process, ncclCommInitAll), recording bandwidth at the largest size and latency at the smallest"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds src/nccl_bw.cu and runs bin/nccl_bw for each yaml collective over message sizes from min_bytes to max_bytes by step_factor. num_gpus: GPUs in the communicator (capped at the GPUs present, max 8)"
  },
  {
